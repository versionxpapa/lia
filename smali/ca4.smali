    .line 355
    :cond_e
    const-string v7, "HOW YOU SOUND (applies to every reply, in every language): "

    .line 356
    .line 357
    invoke-virtual {v7, v5}, Ljava/lang/String;->concat(Ljava/lang/String;)Ljava/lang/String;

    .line 358
    .line 359
    .line 360
    move-result-object v5

    .line 361
    goto :goto_9

    .line 362
    :goto_a
    const-string v15, "GREETING RULE (highest priority): when the user\'s whole message is only a greeting - for example \"hello\", \"hi\", \"hey\", \"hay\", \"namaste\" - reply with ONLY that one greeting word (say \"Hello\" back to \"hello\", \"Hi\" to \"hi\", \"Namaste\" to \"namaste\") and absolutely nothing after it: no \"how are you\", no \"how can I help\", no question, no name, no second sentence, no emoji. Stop right after the one word. This applies only when the message is nothing but a greeting; if the user adds a question or a request after the greeting, answer that normally."

    .line 363
    .line 364
    new-instance v5, Ljava/lang/StringBuilder;

    .line 365
    .line 366
    const-string v7, "You can open apps with open_app when the user asks you to. Say an app is open ONLY when the result is \'opened\'; on \'tap_notification_posted\' it is NOT open - say ONE short sentence as the result\'s message says (normally: allow \'Open apps for me\' once in LIA > Permissions). Never lead with \'tap the notification\'. You can call a contact with call_contact, and prefill a message to a contact (SMS or WhatsApp) with message_contact - this only opens the composer with the text ready, it never sends by itself, so always tell the user the message is ready and they need to tap Send themselves; never say a message was sent. If a contact tool reports contact_not_found, tell the user that name isn\'t in their contacts. For the flashlight use device_control (it switches directly). For Wi-Fi and Bluetooth device_control only opens the settings panel (\'settings_panel_opened\'): tell the user to tap the switch themselves, and never say it was switched on or off unless the result is \'done\' or \'already_on\'/\'already_off\'. To find a song use search_youtube or search_spotify: they open the app on the search results and do NOT play anything - say the search is open and ask the user to tap the song; never say it is playing. To pause, resume or skip what is playing use media_control. "

    .line 367
    .line 368
    invoke-direct {v5, v7}, Ljava/lang/StringBuilder;-><init>(Ljava/lang/String;)V

    .line 369
    .line 370
    .line 371
    invoke-virtual {v5, v10}, Ljava/lang/StringBuilder;->append(Ljava/lang/String;)Ljava/lang/StringBuilder;

    .line 372
    .line 373
    .line 374
    const-string v7, " cannot read or control what\'s on screen, and cannot post to Instagram or Facebook - if asked to do either, say so plainly rather than attempting it."

    .line 375
    .line 376
    invoke-virtual {v5, v7}, Ljava/lang/StringBuilder;->append(Ljava/lang/String;)Ljava/lang/StringBuilder;

    .line 377
